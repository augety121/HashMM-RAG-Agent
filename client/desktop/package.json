{
  "name": "hashmm-desktop",
  "productName": "HashMM",
  "version": "17.0.2",
  "description": "HashMM 桌面端 — 面向用户的证据型 RAG-Agent 工作空间。",
  "main": "main.js",
  "author": "HashMM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "build:webui": "npm --prefix ../frontend-next run build",
    "prepare:runtime": "python scripts/prepare-runtime.py --strict",
    "verify:release": "python scripts/verify-release.py --source-only",
    "predist:win": "npm run build:webui && npm run prepare:runtime && npm run verify:release",
    "predist:mac": "npm run build:webui",
    "predist:linux": "npm run build:webui",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-pty": "^1.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.26.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
