# HashMM V2400 coturn production template. Render with scripts/render-turn-config.py.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49200
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=__HASHMM_TURN_SHARED_SECRET__
realm=__HASHMM_TURN_REALM__
server-name=__HASHMM_TURN_REALM__
external-ip=__HASHMM_TURN_EXTERNAL_IP__
cert=__HASHMM_TURN_CERT__
pkey=__HASHMM_TURN_PKEY__
no-cli
no-loopback-peers
no-multicast-peers
stale-nonce=600
total-quota=1200
user-quota=12
max-bps=25000000
no-software-attribute
log-file=stdout
simple-log

# A public relay must not become a path into loopback, link-local, RFC1918,
# carrier-grade NAT or multicast destinations.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
