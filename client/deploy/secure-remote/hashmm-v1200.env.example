# Never commit real values. Generate independent secrets for JWT, encrypted
# credential storage and TURN.
HASHMM_ENV=production
HASHMM_REQUIRE_AUTH=1
HASHMM_REQUIRE_SECURE_REMOTE=1
HASHMM_PUBLIC_URL=https://hashmm.example.com
HASHMM_CORS_ORIGINS=https://hashmm.example.com

# When cloudflared/nginx runs on the same host, keep loopback only. If a remote
# load balancer is used, add only its exact IP/CIDR.
HASHMM_TRUSTED_PROXIES=127.0.0.1/32,::1/128

HASHMM_JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
HASHMM_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES

HASHMM_SUPABASE_URL=https://REPLACE.supabase.co
HASHMM_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
HASHMM_SUPABASE_SERVICE_KEY=REPLACE_ON_SERVER_ONLY

HASHMM_REMOTE_REQUIRE_TURN=1
HASHMM_TURN_URLS=["turns:turn.example.com:5349?transport=tcp","turn:turn.example.com:3478?transport=udp"]
HASHMM_TURN_SHARED_SECRET=REPLACE_WITH_THIRD_RANDOM_32_PLUS_BYTES
