# HashMM V1200 / Secure Remote Workspace 3.0
# Create the tunnel and DNS route in your own Cloudflare account, then replace
# the placeholders. The origin remains bound to localhost; cloudflared makes an
# outbound connection, so no public inbound port is required.
tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_ID.json

ingress:
  - hostname: hashmm.example.com
    service: http://127.0.0.1:6006
    originRequest:
      connectTimeout: 10s
      noTLSVerify: false
  - service: http_status:404
