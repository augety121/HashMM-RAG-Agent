# HashMM V1300 server-side Cloudflare Computer provider settings.
# Never commit or expose completed values to App, browser or Electron renderer.
HASHMM_CLOUDFLARE_COMPUTER_ENABLED=1
HASHMM_CLOUDFLARE_COMPUTER_URL=https://hashmm-computer.example.workers.dev
HASHMM_CLOUDFLARE_COMPUTER_TOKEN=REPLACE_WITH_RANDOM_GATEWAY_SECRET
HASHMM_WORKSPACE_HANDLE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES
HASHMM_CLOUDFLARE_COMPUTER_TIMEOUT_SECONDS=60
