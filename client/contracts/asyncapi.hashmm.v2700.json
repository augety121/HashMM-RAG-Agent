{
  "asyncapi": "3.0.0",
  "info": { "title": "HashMM Work and Remote Events", "version": "27.0.0" },
  "defaultContentType": "application/json",
  "channels": {
    "workEvents": {
      "address": "/api/work-runs/stream",
      "description": "Authenticated owner-scoped SSE stream. Resume with the server cursor.",
      "messages": { "workEvent": { "$ref": "#/components/messages/workEvent" } }
    },
    "remoteSignal": {
      "address": "/api/remote/v4/ws",
      "description": "Short-lived-ticket authenticated remote signalling; media prefers direct WebRTC.",
      "messages": { "remoteSignal": { "$ref": "#/components/messages/remoteSignal" } }
    }
  },
  "operations": {
    "receiveWorkEvent": { "action": "receive", "channel": { "$ref": "#/channels/workEvents" }, "messages": [{ "$ref": "#/channels/workEvents/messages/workEvent" }] },
    "exchangeRemoteSignal": { "action": "send", "channel": { "$ref": "#/channels/remoteSignal" }, "messages": [{ "$ref": "#/channels/remoteSignal/messages/remoteSignal" }] }
  },
  "components": {
    "messages": {
      "workEvent": {
        "name": "workEvent",
        "payload": {
          "type": "object",
          "required": ["id", "run_id", "seq", "type", "envelope"],
          "properties": {
            "id": { "type": "string" }, "run_id": { "type": "string" },
            "seq": { "type": "integer", "minimum": 1 }, "type": { "type": "string" },
            "envelope": { "$ref": "hashmm-event-v1.schema.json" }
          }
        }
      },
      "remoteSignal": {
        "name": "remoteSignal",
        "payload": {
          "type": "object", "required": ["type", "session_id"],
          "properties": { "type": { "type": "string" }, "session_id": { "type": "string" }, "request_id": { "type": "string" } }
        }
      }
    }
  }
}
