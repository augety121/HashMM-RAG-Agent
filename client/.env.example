# HashMM V2400 configuration template.
# Copy to .env, fill only the capabilities you use, then chmod 600 .env on Linux.
# Never paste the completed .env into chat, source control, an installer, or a startup script.

# ---- Server boundary -------------------------------------------------------
# Local-only is the safe default. AutoDL / LAN / reverse-proxy deployments must use 0.0.0.0
# and complete every production security setting below.
HASHMM_HOST=127.0.0.1
HASHMM_PORT=6006
HASHMM_ENV=dev
HASHMM_REQUIRE_AUTH=0
HASHMM_CORS_ORIGINS=http://localhost:3000,http://localhost:6006
# Server profiles such as start-hashmm1.sh set these automatically.  They make
# startup fail closed when the shared Supabase identity configuration is absent.
# HASHMM_DEPLOYMENT_PROFILE=autodl
HASHMM_IDENTITY_PROVIDER_REQUIRED=supabase
# HASHMM_PUBLIC_URL=https://hashmm.example.com

# Required before exposing HASHMM_HOST=0.0.0.0. The V420 AutoDL launcher
# replaces these two placeholders with independent random values directly in
# .env and changes its Linux mode to 0600; their values are never printed.
# Manual generation remains available for non-launcher deployments:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HASHMM_JWT_SECRET=replace-me-with-a-new-random-value
HASHMM_SECRET=replace-me-with-another-new-random-value

# ---- Optional production remote access ------------------------------------
# Keep these disabled until HTTPS/WSS, a privately operated TURN service and
# real multi-device acceptance have been completed.  Configuration is not
# evidence that symmetric-NAT relay or 24-hour stability has passed.
HASHMM_REQUIRE_SECURE_REMOTE=0
HASHMM_REMOTE_REQUIRE_TURN=0
# V2400 remote bootstrap must name one canonical HTTPS origin. With Cloudflare
# Tunnel on the same host, cloudflared is the only trusted direct proxy peer.
# HASHMM_PUBLIC_URL=https://hashmm.hashlens.org
HASHMM_PROXY_HEADERS=1
HASHMM_TRUSTED_PROXIES=127.0.0.1/32,::1/128
HASHMM_REMOTE_EDGE_MODE=cloudflare-tunnel
# HASHMM_TURN_URLS=["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"]
# HASHMM_TURN_SHARED_SECRET=replace-with-the-same-strong-secret-used-by-coturn
HASHMM_TURN_CREDENTIAL_TTL=3600
HASHMM_REMOTE_AUDIT_RETENTION_DAYS=90
# Remote Fabric v4 presence leases. Keep 35s unless both clients and the
# server are upgraded together (clients heartbeat every 10s).
HASHMM_REMOTE_PRESENCE_TTL=35
# Optional horizontal signaling broker. Leave unset for one server origin.
# Setting this flag is not enough by itself: Redis/NATS transport and multi-node
# acceptance must be deployed before readiness may report multi-instance ready.
# HASHMM_REMOTE_SHARED_BROKER=redis
# Render the checked-in coturn template without printing the secret:
#   HASHMM_TURN_SHARED_SECRET='...' python scripts/render-turn-config.py
# Run one probe on each real network/device, then evaluate the combined report:
#   python scripts/remote-acceptance.py probe --backend https://hashmm.example.com --turn-host turn.example.com --out device-a.json
#   python scripts/remote-acceptance.py evaluate-network --device device-a.json --device device-b.json --audit remote-audit.json --out network-result.json
# A real soak intentionally runs for at least 86400 seconds:
#   python scripts/remote-acceptance.py soak --backend https://hashmm.example.com --duration 86400 --out soak.jsonl

# ---- Models and RAG data ---------------------------------------------------
HASHMM_SRC=/root/autodl-tmp
HASH_INDEX_DIR=/root/autodl-tmp/data/vector_index
HASHMM_BASE_MODEL=/root/autodl-tmp/models/Qwen2.5-7B-Instruct
HASHMM_SEARCHR1_LORA=/root/autodl-tmp/models/qwen2.5-7b-hashmm-final-v2
CUDA_VISIBLE_DEVICES=0
HASHMM_PRESET=max
HASHMM_LAYERED_MEMORY=1
HASHMM_CONTEXT_OFFLOAD=1
HASHMM_WARMUP=0
HASHMM_THREADPOOL_MAX=96
HASHMM_LOOP_GLOBAL_CONCURRENCY=12
HASHMM_LOOP_OWNER_CONCURRENCY=3
HASHMM_ACCESS_TTL=2592000

# ---- Optional cloud sync ---------------------------------------------------
# Leave the whole section empty to disable it. SERVICE_KEY is server-side only.
# HASHMM_SUPABASE_URL=https://your-project.supabase.co
# HASHMM_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# HASHMM_SUPABASE_SERVICE_KEY=your-new-service-role-key
# HASHMM_SUPABASE_ADMIN_EMAILS=owner@example.com

# Supabase URL and publishable key are external account facts and are never
# invented. Preserve your previous private .env, or migrate from an older
# launcher that embedded these values:
#   ./start-hashmm1.sh migrate-env --from-script "/path/to/old-start-hashmm1.sh"
# This parser reads only allowlisted static assignments, never executes the old
# shell script, never prints secret values, preserves existing values, and writes
# .env atomically with mode 0600 on Linux.

# ---- Optional web search / benchmark ingest -------------------------------
# HASHMM_SEARCH_BACKEND=serper
# HASHMM_SERPER_API_KEY=your-new-serper-key
# HASHMM_BENCH_HOME=/root/autodl-tmp/hashmm-benchmarks
# HASHMM_BENCH_MODE=full
# HASHMM_BENCH_CONCURRENCY=6
# HASHMM_BENCH_INGEST_TOKEN=your-new-long-random-ingest-token

# ---- Optional local speech -------------------------------------------------
HASHMM_STT_ENABLED=0
HASHMM_STT_MODEL=small
HASHMM_STT_DEVICE=cuda
HASHMM_STT_COMPUTE=float16
# HF_ENDPOINT=https://hf-mirror.com
# Install explicitly once; normal startup never runs pip or accesses the network:
#   ./hashmm-start.sh install-optional stt

# ---- Durable OCR -----------------------------------------------------------
# Normal startup never runs pip. PaddleOCR/Paddle availability is reported as
# installed_unverified until /api/ocr-jobs/capabilities?probe=true executes a
# real local canary. Existing server environments can keep their package set.
HASHMM_OCR_ENGINE=paddleocr
HASHMM_OCR_DEVICE=gpu
HASHMM_OCR_PDF_DPI=300
HASHMM_OCR_LEASE_SECONDS=180
# Unlimited OCR is an isolated HTTP sidecar. It is disabled by default and the
# main HashMM process sends bounded file bytes plus SHA-256, never a host path.
HASHMM_UNLIMITED_OCR_ENABLED=0
HASHMM_UNLIMITED_OCR_URL=http://127.0.0.1:8011
HASHMM_UNLIMITED_OCR_MAX_BYTES=67108864
HASHMM_UNLIMITED_OCR_ALLOW_REMOTE=0

# ---- Optional Cloudflare Computer Preview ---------------------------------
# The Worker gateway must be deployed separately from
# integrations/cloudflare-computer-worker. Keep both secrets server-side and
# independent. App/browser clients only call the authenticated HashMM API.
HASHMM_CLOUDFLARE_COMPUTER_ENABLED=0
# HASHMM_CLOUDFLARE_COMPUTER_URL=https://hashmm-computer.example.workers.dev
# HASHMM_CLOUDFLARE_COMPUTER_TOKEN=replace-with-worker-gateway-secret
# HASHMM_WORKSPACE_HANDLE_SECRET=replace-with-independent-32-plus-byte-secret
HASHMM_CLOUDFLARE_COMPUTER_TIMEOUT_SECONDS=60
