{
  "schema": "hashmm.plugin.v1",
  "id": "ai_news_radar",
  "version": "1.0.0",
  "description": "Evidence-first AI news radar. Produces owner-scoped, deduplicated candidates for review; it never publishes automatically.",
  "author": "HashMM",
  "enabled": true,
  "runtime": {
    "kind": "manifest"
  },
  "capabilities": [
    "ai_news_radar",
    "daily_ai_hotspots",
    "source_verification"
  ],
  "permissions": {
    "filesystem": "none",
    "network": "read_only_via_scheduler",
    "side_effects": false
  },
  "automations": [
    {
      "id": "daily-ai-hotspots",
      "action": "ai_news_radar",
      "schedule_kind": "daily",
      "default_time": "08:30",
      "result_destination": "conversation",
      "approval": "none",
      "publishes": false
    }
  ],
  "tools": []
}
