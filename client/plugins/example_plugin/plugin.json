{
  "schema": "hashmm.plugin.v1",
  "id": "example_plugin",
  "version": "1.0.0",
  "description": "用于验证插件权限、审查和工具接入链路的本地示例。",
  "author": "HashMM",
  "enabled": true,
  "runtime": {
    "kind": "python",
    "entrypoint": "__init__.py"
  },
  "capabilities": ["示例问候"],
  "permissions": {
    "filesystem": "none",
    "network": "none",
    "side_effects": false
  },
  "tools": [
    {
      "name": "hello_plugin",
      "description": "返回一条本地问候语，不访问文件或网络。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "要问候的名字"
          }
        },
        "required": ["name"]
      },
      "annotations": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false,
        "title": "示例问候"
      }
    }
  ]
}
