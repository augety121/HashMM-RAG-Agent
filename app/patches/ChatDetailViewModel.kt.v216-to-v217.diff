+    /** V217 防御：服务器侧（如快照恢复）可能把同一条消息重复入库——相邻同角色同内容折叠为一条。
+     *  窗口极窄（相邻），不误伤用户刻意重发（中间隔了助手回复就不相邻）。 */
+    private fun dedupeAdjacent(list: List<ChatMessage>): List<ChatMessage> {
+        if (list.size < 2) return list
+        val out = ArrayList<ChatMessage>(list.size)
+        for (m in list) {
+            val last = out.lastOrNull()
+            if (last != null && last.role == m.role && last.content == m.content && m.content.isNotBlank()) continue
+            out.add(m)
+        }
+        return out
+    }
