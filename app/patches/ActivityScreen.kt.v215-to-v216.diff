+@Composable
+private fun RunRow(r: FeedRun) {
+    val cs = MaterialTheme.colorScheme
+    Surface(color = cs.surfaceVariant, shape = RoundedCornerShape(14.dp), modifier = Modifier.fillMaxWidth()) {
+        Row(Modifier.padding(horizontal = 14.dp, vertical = 12.dp), verticalAlignment = Alignment.CenterVertically) {
+            Icon(Icons.Outlined.Bolt, null, tint = cs.primary, modifier = Modifier.size(16.dp))
+            Spacer(Modifier.width(12.dp))
+            Column(Modifier.weight(1f)) {
+                Text(r.title, fontSize = 13.5.sp, color = cs.onSurface, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                val sub = listOf(r.status, fmtAgo(r.tsSec)).filter { it.isNotBlank() }.joinToString(" · ")
+                if (sub.isNotBlank()) { Spacer(Modifier.height(2.dp)); Text(sub, fontSize = 11.5.sp, color = cs.onSurfaceVariant) }
+            }
+        }
+    }
