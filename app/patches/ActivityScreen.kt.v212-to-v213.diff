+
+/** 相对时间："刚刚 / n分钟前 / n小时前 / n天前"。 */
+private fun fmtAgo(sec: Long): String {
+    if (sec <= 0) return ""
+    val d = (System.currentTimeMillis() / 1000 - sec).coerceAtLeast(0)
+    return when {
+        d < 60 -> "刚刚"
+        d < 3600 -> "${d / 60}分钟前"
+        d < 86400 -> "${d / 3600}小时前"
+        else -> "${d / 86400}天前"
+    }
+}
+
+private fun fmtSize(b: Long): String = when {
+    b >= 1_048_576 -> String.format("%.1fMB", b / 1_048_576.0)
+    b >= 1024 -> String.format("%.0fKB", b / 1024.0)
+    else -> "${b}B"
+}
+
+/** 产物卡：扩展名徽章（.html=工作画布，主色染）+ 文件名 + 来源会话 · 大小 · 时间；点击就地预览。 */
+@Composable
+private fun FeedFileCard(file: FeedFile, onOpen: () -> Unit) {
+    val cs = MaterialTheme.colorScheme
+    val ext = file.filename.substringAfterLast('.', "").lowercase()
+    val isCanvas = ext == "html" || ext == "htm"
+    Surface(
+        color = cs.surfaceVariant,
+        shape = RoundedCornerShape(14.dp),
+        modifier = Modifier.fillMaxWidth().clickable(onClick = onOpen),
+    ) {
+        Row(Modifier.padding(horizontal = 14.dp, vertical = 13.dp), verticalAlignment = Alignment.CenterVertically) {
+            Box(
+                Modifier.size(38.dp).background(
+                    if (isCanvas) cs.primary.copy(alpha = 0.14f) else cs.onSurfaceVariant.copy(alpha = 0.10f),
+                    RoundedCornerShape(11.dp),
+                ),
+                contentAlignment = Alignment.Center,
+            ) {
+                Text(
+                    if (isCanvas) "画布" else ext.uppercase().take(4).ifBlank { "文件" },
+                    fontSize = if (isCanvas) 11.sp else 10.sp,
+                    fontWeight = FontWeight.Bold,
+                    color = if (isCanvas) cs.primary else cs.onSurfaceVariant,
+                )
+            }
+            Spacer(Modifier.width(13.dp))
+            Column(Modifier.weight(1f)) {
+                Text(file.filename, fontSize = 14.5.sp, fontWeight = FontWeight.Medium,
+                    color = cs.onSurface, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                Spacer(Modifier.height(2.dp))
+                Text(
+                    listOf(file.convTitle, fmtSize(file.size), fmtAgo(file.mtimeSec))
+                        .filter { it.isNotBlank() }.joinToString(" · "),
+                    fontSize = 12.sp, color = cs.onSurfaceVariant, maxLines = 1, overflow = TextOverflow.Ellipsis,
+                )
+            }
+            Icon(Icons.AutoMirrored.Outlined.ArrowForward, null, tint = cs.onSurfaceVariant.copy(alpha = 0.7f), modifier = Modifier.size(16.dp))
+        }
+    }
+}
