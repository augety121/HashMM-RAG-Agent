+@Composable
+private fun RunnersCard(f: FeedData) {
+    val cs = MaterialTheme.colorScheme
+    val anyOnline = f.runners.any { it.online }
+    Surface(color = cs.surfaceVariant, shape = RoundedCornerShape(14.dp), modifier = Modifier.fillMaxWidth()) {
+        Row(Modifier.padding(horizontal = 14.dp, vertical = 12.dp), verticalAlignment = Alignment.CenterVertically) {
+            Icon(Icons.Outlined.Computer, null, tint = if (anyOnline) cs.primary else cs.onSurfaceVariant, modifier = Modifier.size(18.dp))
+            Spacer(Modifier.width(12.dp))
+            Text(
+                f.runners.joinToString("、") { it.name + if (it.online) "（在线）" else "（离线）" },
+                fontSize = 13.sp, color = cs.onSurface, maxLines = 2, overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.weight(1f),
+            )
+            Box(Modifier.size(8.dp).background(if (anyOnline) cs.primary else cs.onSurfaceVariant.copy(alpha = 0.5f), CircleShape))
